.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Environment files
.env
.env.*
!.env.example

# Local agent skills/config. Personal settings and third-party skills stay out of the repo; the
# project's own e2e suite is tracked, because it is test code for this product rather than
# reinstallable tooling. Written as .claude/* (not .claude/) since git cannot re-include anything
# under an excluded directory.
.agents/
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/mirror-e2e/
.claude/skills/mirror-e2e/build/
skills-lock.json

# Temporary files
tmp/
temp/
*.tmp
*.log

# Keep source and required app assets tracked.
!android/app/src/main/assets/
!android/app/src/main/assets/input_mirror/
!android/app/src/main/assets/input_mirror/input_mirror
